# İletişim formu e-posta gönderimi (opsiyonel).
# Tanımlanmazsa form yine çalışır; talepler yalnızca sunucu loguna düşer.
#
# 1) resend.com üzerinden ücretsiz hesap açın
# 2) API Keys bölümünden bir anahtar oluşturun
# 3) Aşağıdaki değerleri Vercel > Project > Settings > Environment Variables içine girin

RESEND_API_KEY=
CONTACT_TO_EMAIL=info@biinsaat.com
# Alan adınızı Resend'de doğruladıktan sonra kendi adresinizi kullanın:
CONTACT_FROM_EMAIL=Bi Insaat Web <onboarding@resend.dev>
